VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — public site URL for canonical, Open Graph and sitemap
# VITE_SITE_URL=https://fisionotes.com.br

# Optional — WhatsApp business number with country code, digits only (e.g. 5511999999999)
# VITE_WHATSAPP_PHONE=

# Optional — app public URL (used in Google Calendar event links / OAuth return)
# APP_URL=http://localhost:5173

# Optional — Google Calendar sync (Supabase Edge Function secrets)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_ENCRYPTION_KEY=
# Redirect URI to register in Google Cloud Console:
#   {VITE_SUPABASE_URL}/functions/v1/google-calendar-oauth-callback

# Optional — Daily teleconsulta (server-side secret in Supabase Edge Function)
# DAILY_API_KEY=
# DAILY_DOMAIN=

# Optional — Stripe (server-side secrets in Supabase Edge Functions — never Vite)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SAAS_PRICE_ID=
# STRIPE_SAAS_TRIAL_DAYS=7
# APP_URL=https://fisionotes.com.br
# New checkouts get a 7-day free trial (card collected, charged after trial).
# create-saas-checkout + stripe-webhook create the physio account and email access.
# create-saas-portal opens the Stripe Customer Portal (cancel / update card).
# Dashboard: Billing → Customer portal → enable cancellation during trial.

# Optional — invite email via the consultorio Gmail (Supabase Edge Function secrets)
# GMAIL_USER=consultorio@gmail.com
# GMAIL_APP_PASSWORD=
