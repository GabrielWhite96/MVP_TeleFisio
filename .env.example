VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — app public URL (used in Google Calendar event links / OAuth return)
# APP_URL=http://localhost:5173

# Optional — Google Calendar sync (Supabase Edge Function secrets)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_ENCRYPTION_KEY=
# Redirect URI to register in Google Cloud Console:
#   {VITE_SUPABASE_URL}/functions/v1/google-calendar-oauth-callback

# Optional — Daily teleconsulta (server-side secret in Supabase Edge Function)
# DAILY_API_KEY=
# DAILY_DOMAIN=

# Optional — Stripe (server-side secrets in Supabase Edge Functions — never Vite)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SAAS_PRICE_ID=
# APP_URL=https://tele-fisio.netlify.app
# After payment, create-saas-checkout + stripe-webhook create the physio account
# and email the generated password via GMAIL_USER.

# Optional — invite email via the consultorio Gmail (Supabase Edge Function secrets)
# GMAIL_USER=consultorio@gmail.com
# GMAIL_APP_PASSWORD=
